# =======================
# Configuracao local da API Cakes Borges
# =======================
PORT=3001
# Use a URL Session Pooler copiada de Connect no painel do Supabase.
# Troque os campos entre colchetes; codifique caracteres reservados da senha.
# Remova parâmetros SSL da URL; a API aplica TLS e valida o certificado raiz abaixo.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres
# Baixe o certificado raiz em Database Settings > SSL Configuration no Supabase.
# Salve como server/supabase-root.crt; o caminho relativo e resolvido a partir desta pasta.
DATABASE_SSL_CA_PATH=./supabase-root.crt
# Mesmo projeto Supabase usado no frontend; use apenas a URL e a chave anon/publica.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[PUBLIC-ANON-OR-PUBLISHABLE-KEY]
# Taxa provisoria de entrega em reais; defina o valor comercial antes de receber pedidos reais.
DELIVERY_FEE=0
# UUIDs de usuários Supabase da equipe autorizados a gerenciar pedidos, separados por vírgula.
ORDER_MANAGER_USER_IDS=
NODE_ENV=development
