# =======================
# Configuracao local da API Cakes Borges
# =======================
PORT=3001
# Use a URL Session Pooler copiada de Connect no painel do Supabase.
# Troque os campos entre colchetes; codifique caracteres reservados da senha.
# Compatibilidade SSL para o driver pg no Node; em produção, configure a CA para verificar o certificado.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?uselibpqcompat=true&sslmode=require
# Mesmo projeto Supabase usado no frontend; use apenas a URL e a chave anon/publica.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[PUBLIC-ANON-OR-PUBLISHABLE-KEY]
# Taxa provisoria de entrega em reais; defina o valor comercial antes de receber pedidos reais.
DELIVERY_FEE=0
# E-mails de funcionários autorizados a acompanhar/atualizar pedidos, separados por vírgula.
ORDER_MANAGER_EMAILS=
NODE_ENV=development
